#!/bin/bash

# omarchy:summary=Reload brcmfmac if Wi-Fi does not return after resume
# omarchy:group=system
# omarchy:hidden=true
# omarchy:requires-sudo=true

# The Broadcom firmware on Apple Silicon Macs (BCM4378/BCM4387) can wedge
# across s2idle: scans fail with -52 and every association is rejected with
# status_code=16, which NetworkManager surfaces as a wrong password. Toggling
# the radio does not reset the chip firmware - only a driver reload does.
# Upstream: https://github.com/AsahiLinux/linux/issues/439
#
# Run by omarchy-wifi-resume-fix.service after each resume (installed by
# install/hardware/apple/fix-wifi-resume.sh). Output goes to the journal:
#   journalctl -u omarchy-wifi-resume-fix

WAIT_BEFORE=12 # backstop: reload anyway if wifi is still not up after this
WAIT_AFTER=30  # seconds to wait for reconnect after a reload
REJECTS=2      # ASSOC-REJECT status_code=16 events that confirm a wedge

START=$(date '+%Y-%m-%d %H:%M:%S')

wifi_iface() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null |
    awk -F: '$2 == "wifi" { print $1; exit }'
}

wifi_state() {
  nmcli -t -f DEVICE,STATE device status 2>/dev/null |
    awk -F: -v d="$1" '$1 == d { print $2; exit }'
}

# The wedged firmware rejects every association with status_code=16, repeating
# every few seconds. A healthy association never does this, so seeing it more
# than once confirms the wedge and we can reload immediately - typically ~7s
# after resume - rather than sitting out the full backstop timer.
wedged() {
  local n output
  # The `--since` window is empty when the clock stepped backwards across
  # resume (an RTC quirk on some Apple Silicon kernels); fall back to the
  # trailing wpa_supplicant log so the signature is still caught.
  output=$(journalctl --since "$START" -t wpa_supplicant --no-pager 2>/dev/null || true)
  if [[ -z $output ]]; then
    output=$(journalctl -t wpa_supplicant --no-pager 2>/dev/null | tail -n 200 || true)
  fi
  n=$(printf '%s\n' "$output" | grep -c 'CTRL-EVENT-ASSOC-REJECT.*status_code=16')
  ((${n:-0} >= REJECTS))
}

# Respect a deliberately disabled radio - do not fight the user or rfkill.
if [[ $(nmcli radio wifi 2>/dev/null) == "disabled" ]]; then
  echo "wifi radio is disabled, nothing to do"
  exit 0
fi

for cmd in nmcli journalctl modprobe; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "missing $cmd - cannot recover Wi-Fi"
    exit 1
  fi
done

IFACE=$(wifi_iface)
: "${IFACE:=wlan0}"

i=0
while ((i < WAIT_BEFORE)); do
  state=$(wifi_state "$IFACE")
  if [[ $state == "connected" ]]; then
    echo "wifi back after ${i}s on $IFACE - no reload needed"
    exit 0
  fi
  if wedged; then
    echo "wedged firmware confirmed after ${i}s (iface=$IFACE state=${state:-none}) - reloading brcmfmac"
    break
  fi
  i=$((i + 1))
  sleep 1
done

if ((i >= WAIT_BEFORE)); then
  echo "wifi not back after ${WAIT_BEFORE}s (iface=$IFACE state=${state:-none}) - reloading brcmfmac"
fi

if ! modprobe -r brcmfmac_wcc brcmfmac; then
  echo "failed to unload brcmfmac - giving up, a reboot is needed"
  exit 1
fi
sleep 1
if ! modprobe brcmfmac; then
  echo "failed to reload brcmfmac - giving up, a reboot is needed"
  exit 1
fi
echo "brcmfmac reloaded, waiting for NetworkManager to reconnect"

i=0
while ((i < WAIT_AFTER)); do
  IFACE=$(wifi_iface)
  : "${IFACE:=wlan0}"
  state=$(wifi_state "$IFACE")
  if [[ $state == "connected" ]]; then
    echo "reconnected ${i}s after reload on $IFACE"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done

echo "still not connected ${WAIT_AFTER}s after reload (iface=$IFACE state=${state:-none})"
exit 1
