#!/bin/bash
# Build the Hyprland dependency stack inside a disposable Arch Linux ARM
# userspace on an aarch64 host. The output is a release-ready repository tree,
# but this harness deliberately has no publishing step.

set -euo pipefail

PACKAGES=(aquamarine hyprtoolkit hyprland-guiutils hyprland)

if [[ ${1:-} == "--print-plan" ]]; then
  printf '%s\n' "${PACKAGES[@]}"
  exit 0
fi

if (( $# )); then
  printf 'Usage: %s [--print-plan]\n' "$0" >&2
  exit 2
fi

CACHE="${OMARCHY_AARCH64_BUILD_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-aarch64-build}"
WORK="${OMARCHY_AARCH64_BUILD_WORK:-/var/tmp/omarchy-aarch64-build}"
TARBALL_URL="${OMARCHY_AARCH64_BUILD_TARBALL:-https://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz}"
REPO_URL="${OMARCHY_AARCH64_REPO_URL:-https://github.com/omarchy-mac/omarchy-pkgs-aarch64/releases/download/edge}"
REPO_NAME=omarchy-aarch64
GUEST_USER=ci
PREPARED_CACHE_VERSION=2
ROOTFS_SIGNING_FINGERPRINT=68B3537F39A313B3E574D06777193F152BDBE6A6
ROOTFS_KEYSERVER=hkps://keyserver.ubuntu.com
KEEP_ROOT=${OMARCHY_AARCH64_BUILD_KEEP:-0}
CALLER_UID=${SUDO_UID:-$(id -u)}
CALLER_GID=${SUDO_GID:-$(id -g)}

log() { printf '\033[32m==>\033[0m %s\n' "$*"; }
fail() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

as_root() {
  if (( EUID == 0 )); then
    "$@"
  else
    sudo "$@"
  fi
}

cleanup() {
  as_root chmod -R a+rX "$WORK/logs" "$WORK/staging" 2>/dev/null || true
  as_root chown -R "$CALLER_UID:$CALLER_GID" "$WORK/logs" "$WORK/staging" 2>/dev/null || true
  if (( KEEP_ROOT )); then
    log "keeping $WORK/root (OMARCHY_AARCH64_BUILD_KEEP=1)"
  else
    as_root rm -rf "$WORK/root" "$WORK/consumer-root"
  fi
}

[[ $(uname -m) == "aarch64" ]] || fail "this harness only runs on aarch64"
command -v systemd-nspawn >/dev/null || fail "systemd-nspawn is required"
command -v curl >/dev/null || fail "curl is required"
command -v gpg >/dev/null || fail "gpg is required"
command -v sha256sum >/dev/null || fail "sha256sum is required"
as_root true || fail "root (or passwordless sudo) is required to spawn the machine"

mkdir -p "$CACHE"
as_root rm -rf "$WORK/root" "$WORK/consumer-root" "$WORK/packages" "$WORK/staging" "$WORK/logs"
as_root mkdir -p "$WORK/root" "$WORK/packages" "$WORK/staging" "$WORK/logs"
as_root chown -R "$CALLER_UID:$CALLER_GID" "$WORK/packages" "$WORK/staging" "$WORK/logs"
trap cleanup EXIT

tarball="$CACHE/ArchLinuxARM-aarch64-latest.tar.gz"
signature="$tarball.sig"

verify_rootfs() {
  local archive="$1" detached_signature="$2" keyring imported_fingerprint status signer_fingerprint result=0

  keyring=$(mktemp -d "$WORK/rootfs-keyring.XXXXXX")
  chmod 700 "$keyring"

  if ! gpg --batch --homedir "$keyring" --keyserver "$ROOTFS_KEYSERVER" \
    --recv-keys "$ROOTFS_SIGNING_FINGERPRINT" >/dev/null 2>&1; then
    result=1
  else
    imported_fingerprint=$(gpg --batch --homedir "$keyring" --with-colons \
      --fingerprint "$ROOTFS_SIGNING_FINGERPRINT" 2>/dev/null |
      awk -F: '$1 == "fpr" { print $10; exit }')
    if [[ $imported_fingerprint != "$ROOTFS_SIGNING_FINGERPRINT" ]]; then
      result=1
    elif ! status=$(gpg --batch --homedir "$keyring" --status-fd=1 \
      --verify "$detached_signature" "$archive" 2>/dev/null); then
      result=1
    else
      signer_fingerprint=$(awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { print $3; exit }' <<<"$status")
      [[ $signer_fingerprint == "$ROOTFS_SIGNING_FINGERPRINT" ]] || result=1
    fi
  fi

  rm -rf "$keyring"
  (( result == 0 ))
}

if [[ -f $tarball && -f $signature ]]; then
  log "re-verifying cached Arch Linux ARM rootfs"
  if ! verify_rootfs "$tarball" "$signature"; then
    log "discarding an unverified rootfs cache"
    rm -f "$tarball" "$signature"
  fi
elif [[ -f $tarball || -f $signature ]]; then
  rm -f "$tarball" "$signature"
fi

if [[ ! -f $tarball ]]; then
  log "downloading and verifying Arch Linux ARM rootfs"
  download_dir=$(mktemp -d "$WORK/rootfs-download.XXXXXX")
  curl -fL --retry 3 -o "$download_dir/rootfs.tar.gz" "$TARBALL_URL"
  curl -fL --retry 3 -o "$download_dir/rootfs.tar.gz.sig" "$TARBALL_URL.sig"
  if ! verify_rootfs "$download_dir/rootfs.tar.gz" "$download_dir/rootfs.tar.gz.sig"; then
    rm -rf "$download_dir"
    fail "Arch Linux ARM rootfs signature did not match $ROOTFS_SIGNING_FINGERPRINT"
  fi
  mv "$download_dir/rootfs.tar.gz" "$tarball"
  mv "$download_dir/rootfs.tar.gz.sig" "$signature"
  rmdir "$download_dir"
fi

rootfs_digest=$(sha256sum "$tarball" | awk '{ print $1 }')
prepared="$CACHE/prepared-builder-aarch64-v${PREPARED_CACHE_VERSION}-${rootfs_digest}.tar.gz"
prepared_checksum="$prepared.sha256"
if [[ -f $prepared && -f $prepared_checksum ]] &&
  (cd "$CACHE" && sha256sum -c "$(basename "$prepared_checksum")" >/dev/null 2>&1); then
  log "restoring prepared builder rootfs"
  as_root tar -xzf "$prepared" -C "$WORK/root"
else
  rm -f "$prepared" "$prepared_checksum"
  log "extracting Arch Linux ARM rootfs"
  as_root tar -xzf "$tarball" -C "$WORK/root"
fi

as_root mkdir -p "$WORK/root/output" "$WORK/root/staging"

nspawn() {
  as_root systemd-nspawn \
    --directory="$WORK/root" \
    --register=no \
    --resolv-conf=bind-host \
    --bind="$WORK/packages:/output" \
    --bind="$WORK/staging:/staging" \
    --console=pipe \
    "$@"
}

if [[ ! -f $prepared ]]; then
  log "bootstrapping the isolated package builder"
  nspawn /bin/bash -euo pipefail <<'BOOTSTRAP'
pacman-key --init
pacman-key --populate archlinuxarm
pacman -Sy --noconfirm
pacman -S --needed --noconfirm base-devel git sudo
id ci >/dev/null 2>&1 || useradd -m -G wheel ci
printf '%s\n' 'ci ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/ci
chmod 440 /etc/sudoers.d/ci
BOOTSTRAP

  log "saving prepared builder rootfs"
  prepared_partial="$prepared.partial"
  as_root rm -f "$prepared_partial"
  as_root tar -czf "$prepared_partial" -C "$WORK/root" .
  as_root chown "$CALLER_UID:$CALLER_GID" "$prepared_partial"
  mv "$prepared_partial" "$prepared"
  (cd "$CACHE" && sha256sum "$(basename "$prepared")" >"$(basename "$prepared_checksum")")
  as_root chown "$CALLER_UID:$CALLER_GID" "$prepared_checksum"
fi

log "updating the disposable builder"
nspawn /bin/bash -euo pipefail -c 'pacman -Syu --noconfirm'

# The host runner and the guest build user need not have the same numeric uid.
# A bind mount preserves numeric ownership, so make the package output writable
# by the actual guest uid and restore host ownership during cleanup.
guest_uid=$(as_root chroot "$WORK/root" id -u "$GUEST_USER")
guest_gid=$(as_root chroot "$WORK/root" id -g "$GUEST_USER")
as_root chown "$guest_uid:$guest_gid" "$WORK/packages"

log "building the Hyprland stack in dependency order"
nspawn --user="$GUEST_USER" --chdir=/home/ci /bin/bash -euo pipefail <<'BUILD' | tee "$WORK/logs/build.log"
packages=(aquamarine hyprtoolkit hyprland-guiutils hyprland)
keyserver=hkps://keyserver.ubuntu.com
rm -rf /home/ci/build
mkdir -p /home/ci/build
: >/output/source-commits.txt

import_validpgpkeys() {
  local source_dir="$1" key normalized
  local -a signing_keys=()

  mapfile -t signing_keys < <(
    cd "$source_dir"
    makepkg --printsrcinfo | sed -n 's/^[[:space:]]*validpgpkeys[[:space:]]*=[[:space:]]*//p'
  )

  for key in "${signing_keys[@]}"; do
    normalized=${key^^}
    if [[ ! $normalized =~ ^[0-9A-F]{40}$ ]]; then
      printf 'Error: invalid validpgpkeys fingerprint in %s: %s\n' "$source_dir/PKGBUILD" "$key" >&2
      exit 1
    fi
    gpg --batch --keyserver "$keyserver" --recv-keys "$normalized"
    if ! gpg --batch --with-colons --fingerprint --fingerprint "$normalized" |
      awk -F: '$1 == "fpr" { print $10 }' | grep -qx "$normalized"; then
      printf 'Error: keyserver did not return exact fingerprint %s\n' "$normalized" >&2
      exit 1
    fi
  done
}

for package in "${packages[@]}"; do
  printf '\n==> Building %s\n' "$package"
  source_dir="/home/ci/build/$package"
  git clone --depth 1 "https://gitlab.archlinux.org/archlinux/packaging/packages/$package.git" "$source_dir"
  printf '%s %s\n' "$package" "$(git -C "$source_dir" rev-parse HEAD)" >>/output/source-commits.txt

  # Arch's official recipes are restricted to its build architecture. These
  # projects build from source, so override only makepkg's architecture gate.
  # Refuse recipes with architecture-specific sources instead of accidentally
  # packaging an x86_64 binary for ARM.
  if grep -qE '^source_x86_64=' "$source_dir/PKGBUILD"; then
    printf 'Error: %s uses source_x86_64 and cannot be safely architecture-overridden\n' "$package" >&2
    exit 1
  fi
  printf "\n# Omarchy Mac CI: native Arch Linux ARM build\narch=('aarch64')\n" >>"$source_dir/PKGBUILD"
  import_validpgpkeys "$source_dir"

  (
    cd "$source_dir"
    makepkg --cleanbuild --force --noconfirm --syncdeps
    mapfile -t artifacts < <(makepkg --packagelist)
    (( ${#artifacts[@]} ))
    for artifact in "${artifacts[@]}"; do
      [[ -f $artifact ]] || {
        printf 'Error: expected artifact is missing: %s\n' "$artifact" >&2
        exit 1
      }
      cp "$artifact" /output/
    done
    sudo pacman -U --needed --noconfirm "${artifacts[@]}"
  )
done
BUILD

mapfile -t built < <(find "$WORK/packages" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print | sort)
(( ${#built[@]} )) || fail "the isolated builder produced no packages"

log "fetching the current edge database"
for database in "$REPO_NAME.db.tar.zst" "$REPO_NAME.files.tar.zst"; do
  curl -fL --retry 3 -o "$WORK/staging/$database" "$REPO_URL/$database"
done

log "staging packages and updating the repository metadata"
for package in "${built[@]}"; do
  # GitHub release assets cannot contain a colon. Keep the database filename
  # identical to the asset name that GitHub will serve if this is published.
  filename=$(basename "$package")
  cp "$package" "$WORK/staging/${filename//:/.}"
done

nspawn /bin/bash -euo pipefail <<STAGE
cd /staging
repo-add "$REPO_NAME.db.tar.zst" ./*.pkg.tar.*
rm -f "$REPO_NAME.db" "$REPO_NAME.files"
cp "$REPO_NAME.db.tar.zst" "$REPO_NAME.db"
cp "$REPO_NAME.files.tar.zst" "$REPO_NAME.files"
STAGE

printf '%s\n' "${PACKAGES[@]}" >"$WORK/staging/build-order.txt"
printf '%s\n' "$REPO_URL" >"$WORK/staging/base-repository.txt"
cp "$WORK/packages/source-commits.txt" "$WORK/staging/source-commits.txt"

log "testing the staged repository from a clean verified rootfs"
as_root mkdir -p "$WORK/consumer-root"
as_root tar -xzf "$tarball" -C "$WORK/consumer-root"
as_root mkdir -p "$WORK/consumer-root/staging"
as_root systemd-nspawn \
  --directory="$WORK/consumer-root" \
  --register=no \
  --resolv-conf=bind-host \
  --bind="$WORK/staging:/staging" \
  --setenv=OMARCHY_AARCH64_REPO_URL="$REPO_URL" \
  --console=pipe \
  /bin/bash -euo pipefail <<'CONSUMER' | tee "$WORK/logs/consumer.log"
pacman-key --init
pacman-key --populate archlinuxarm
{
  printf '[omarchy-aarch64]\n'
  printf 'SigLevel = Never\n'
  printf 'Server = file:///staging\n'
  printf 'Server = %s\n' "$OMARCHY_AARCH64_REPO_URL"
  printf '\n'
  cat /etc/pacman.conf
} >/etc/pacman.conf.new
mv /etc/pacman.conf.new /etc/pacman.conf
pacman -Syu --noconfirm

packages=(aquamarine hyprtoolkit hyprland-guiutils hyprland)
for package in "${packages[@]}"; do
  repository=$(LC_ALL=C pacman -Si "$package" | sed -n 's/^Repository[[:space:]]*:[[:space:]]*//p')
  [[ $repository == "omarchy-aarch64" ]]
done
pacman -S --noconfirm "${packages[@]}"
pacman -T "${packages[@]}"
for package in "${packages[@]}"; do
  architecture=$(LC_ALL=C pacman -Qi "$package" | sed -n 's/^Architecture[[:space:]]*:[[:space:]]*//p')
  [[ $architecture == "aarch64" ]]
done
printf 'ok - staged repository installs and resolves the complete aarch64 stack\n'
CONSUMER

log "staged repository tree in $WORK/staging"
ls -lh "$WORK/staging"
